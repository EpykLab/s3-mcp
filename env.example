# S3-compatible configuration
# Region used for signing requests (many providers accept us-east-1)
S3_REGION=us-east-1

# Optional custom endpoint for non-AWS providers
# Examples:
# - MinIO: http://localhost:9000
# - Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
# - Backblaze B2 S3: https://s3.<region>.backblazeb2.com
S3_ENDPOINT_URL=

# Optional S3 config file (JSON or TOML) for credentials and endpoint settings
# Example: ./s3.config.toml
# S3_CONFIG_FILE=
# S3_CONFIG_PROFILE=default
# File can include `buckets = ["my-space"]` to avoid ListBuckets permission requirements

# Precedence order:
# 1) Explicit environment variables (S3_* and AWS_*)
# 2) S3_CONFIG_FILE values
# 3) SDK defaults/credential provider chain

# Optional credentials aliases (AWS_* variables are also supported by botocore)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=

# Optional client behavior
# S3_ADDRESSING_STYLE=auto   # auto | path | virtual
# S3_SIGNATURE_VERSION=s3v4
# S3_VERIFY_SSL=true

# Maximum number of buckets to process
S3_MAX_BUCKETS=5

# Specify buckets using either method:
# Method 1: Comma-separated list
# This also bypasses the ListBuckets API call (useful for restricted keys)
S3_BUCKETS=bucket1,bucket2,bucket3

# Method 2: Individual entries
# S3_BUCKET_1=mybucket1
# S3_BUCKET_2=mybucket2
# S3_BUCKET_3=mybucket3
